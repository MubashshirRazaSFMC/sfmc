      "content": ""
    },
    {
      "id": "b4",
      "kind": "html",
      "name": "Body copy",
      "content": "<body style=\"margin: 0; padding: 0; background-color: #f4f7f9;\">\n\n  <!-- Main Wrapper -->\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f4f7f9; padding: 40px 15px;\">\n    <tr>\n      <td align=\"center\">\n        \n        <!-- Email Container -->\n        <table class=\"email-container\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);\">\n          \n          <!-- Header Banner -->\n          <tr>\n            <td align=\"center\" style=\"background: linear-gradient(135deg, #2563eb, #1d4ed8); padding: 35px 20px;\">\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 26px; font-weight: 600; letter-spacing: 0.5px;\">Welcome Aboard! 🎉</h1>\n            </td>\n          </tr>\n\n          <!-- Main Body -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding: 40px 40px 30px 40px;\">\n              <p style=\"margin: 0 0 15px 0; font-size: 18px; color: #1e293b; font-weight: 600;\">\n                %%=v(@greeting)=%%\n              </p>\n              <p style=\"margin: 0 0 25px 0; font-size: 15px; line-height: 1.6; color: #475569;\">\n                Thank you for registering with us! We are thrilled to have you on board. Here is a summary of the details we currently have on file for your profile:\n              </p>\n\n              <!-- Details Card -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 20px; margin-bottom: 30px;\">\n                \n                <!-- 1. Full Name Row -->\n                %%[ IF NOT EMPTY(@finalFullName) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" width=\"35%\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;\">Full Name</td>\n                  <td class=\"detail-value\" width=\"65%\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;\">%%=v(@finalFullName)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n                <!-- 2. Email Address Row -->\n                %%[ IF NOT EMPTY(@emailLower) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;\">Email Address</td>\n                  <td class=\"detail-value\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;\">%%=v(@emailLower)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n                <!-- 3. Phone Number Row -->\n                %%[ IF NOT EMPTY(@phone) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;\">Phone Number</td>\n                  <td class=\"detail-value\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;\">%%=v(@phone)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n                <!-- 4. Date of Birth Row -->\n                %%[ IF NOT EMPTY(@dob) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;\">Date of Birth</td>\n                  <td class=\"detail-value\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;\">%%=v(@dob)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n                <!-- 5. Preferences Row -->\n                %%[ IF NOT EMPTY(@pref) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600; border-bottom: 1px solid #f1f5f9;\">Preferences</td>\n                  <td class=\"detail-value\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500; border-bottom: 1px solid #f1f5f9;\">%%=v(@pref)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n                <!-- 6. Address Row -->\n                %%[ IF NOT EMPTY(@fullAddress) THEN ]%%\n                <tr>\n                  <td class=\"detail-label\" style=\"padding: 10px 0; font-size: 14px; color: #64748b; font-weight: 600;\">Address</td>\n                  <td class=\"detail-value\" style=\"padding: 10px 0; font-size: 14px; color: #1e293b; font-weight: 500;\">%%=v(@fullAddress)=%%</td>\n                </tr>\n                %%[ ENDIF ]%%\n\n              </table>\n\n              <!-- Call to Action (Update Info) -->\n              <p style=\"margin: 0 0 20px 0; font-size: 14px; line-height: 1.5; color: #475569; text-align: center;\">\n                Notice a typo or need to make a change? You can easily update your profile anytime.\n              </p>\n\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td align=\"center\" style=\"padding-bottom: 25px;\">\n                    <a href=\"https://yourwebsite.com/update-profile\" class=\"btn\" style=\"background-color: #2563eb; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 6px; font-weight: 600; font-size: 15px; display: inline-block;\">\n                      Update Your Information\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Sign-off -->\n              <p style=\"margin: 15px 0 0 0; font-size: 15px; line-height: 1.6; color: #475569; border-top: 1px solid #e2e8f0; padding-top: 20px;\">\n                Best regards,<br>\n                <strong style=\"color: #1e293b;\">The Team</strong>\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"background-color: #f1f5f9; padding: 20px 40px; font-size: 12px; color: #94a3b8; line-height: 1.5;\">\n              <p style=\"margin: 0;\">&copy; 2026 Your Company Name. All rights reserved.</p>\n              <p style=\"margin: 5px 0 0 0;\">\n                If you didn't create an account with us, please ignore this email or <a href=\"mailto:support@yourwebsite.com\" style=\"color: #2563eb; text-decoration: underline;\">contact support</a>.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n        <!-- End Email Container -->\n\n      </td>\n    </tr>\n  </table>\n\n</body>"
    },
